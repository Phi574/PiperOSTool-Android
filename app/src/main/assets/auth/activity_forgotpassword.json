{
  "schemaVersion": 1,
  "screenId": "forgot_password",
  "layout": {
    "type": "frame", "id": "forgotRoot", "width": "match", "height": "match", "background": "@drawable/bg_liquid_main",
    "children": [
      { "type": "scroll", "width": "match", "height": "match", "fillViewport": true,
        "children": [
          { "type": "linear", "width": "match", "height": "wrap", "orientation": "vertical", "gravity": "center_horizontal", "padding": [24, 36, 24, 32],
            "children": [
              { "type": "image", "width": 64, "height": 64, "src": "@drawable/a2tn", "contentDescription": "@string/app_name" },
              { "type": "text", "id": "forgotTitle", "width": "wrap", "height": "wrap", "margin": [0, 14, 0, 0], "gravity": "center", "text": "@string/auth_recovery_title", "textColor": "#FFFFFF", "textSize": 26, "bold": true },
              { "type": "text", "id": "forgotVersion", "width": "wrap", "height": "wrap", "margin": [0, 4, 0, 0], "text": "@string/auth_version_placeholder", "textColor": "#AFFFFFFF", "textSize": 12 },
              { "type": "text", "id": "forgotOfflineState", "width": "match", "height": "wrap", "margin": [0, 18, 0, 0], "background": "@drawable/bg_offline_notice", "paddingAll": 14, "text": "@string/auth_offline_note", "textColor": "#FFFFD180", "textSize": 13, "visibility": "gone" },
              { "type": "linear", "width": "match", "height": "wrap", "margin": [0, 20, 0, 0], "background": "@drawable/bg_auth_panel", "orientation": "vertical", "paddingAll": 20,
                "children": [
                  { "type": "text", "id": "forgotSummary", "width": "match", "height": "wrap", "text": "@string/auth_recovery_summary", "textColor": "#B3FFFFFF", "textSize": 14 },
                  { "type": "edit", "id": "edtForgotEmail", "width": "match", "height": 54, "margin": [0, 20, 0, 0], "background": "@drawable/bg_auth_input", "padding": [14, 8], "hint": "@string/auth_registered_email", "inputType": "textEmailAddress", "textColor": "#FFFFFF", "textSize": 14 },
                  { "type": "button", "id": "btnResetPassword", "width": "match", "height": 54, "margin": [0, 18, 0, 0], "background": "@drawable/bg_auth_primary", "text": "@string/auth_send_reset", "textColor": "#07120B", "textSize": 14 }
                ]
              },
              { "type": "text", "id": "tvBackToLoginFromForgot", "width": "match", "height": 52, "margin": [0, 14, 0, 0], "background": "@drawable/bg_auth_panel", "gravity": "center", "text": "@string/auth_return_login", "textColor": "#DFFFFFFF", "textSize": 13 }
            ]
          }
        ]
      }
    ]
  }
}
