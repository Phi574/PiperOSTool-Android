<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PiperOSTool" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#FB8D8D</item>
        <item name="colorPrimaryVariant">#FB4C4C</item>
        <item name="colorOnPrimary">#FFA5A5</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:fontFamily">@font/piper_app_font</item>
        <item name="fontFamily">@font/piper_app_font</item>
        <item name="android:imageButtonStyle">@style/PiperContainedImageButton</item>
        <item name="imageButtonStyle">@style/PiperContainedImageButton</item>
    </style>
    <style name="Theme.PiperOSTool.AppCompat.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/piper_app_font</item>
        <item name="fontFamily">@font/piper_app_font</item>
        <item name="android:imageButtonStyle">@style/PiperContainedImageButton</item>
        <item name="imageButtonStyle">@style/PiperContainedImageButton</item>
    </style>
    <style name="Theme.PiperOSTool.AppCompat.Light.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">@font/piper_app_font</item>
        <item name="fontFamily">@font/piper_app_font</item>
        <item name="android:imageButtonStyle">@style/PiperContainedImageButton</item>
        <item name="imageButtonStyle">@style/PiperContainedImageButton</item>
    </style>

    <style name="PiperContainedImageView">
        <item name="android:adjustViewBounds">false</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="PiperContainedImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:adjustViewBounds">false</item>
        <item name="android:scaleType">centerInside</item>
    </style>
    <style name="Theme.App.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/piper_app_font</item>
        <item name="fontFamily">@font/piper_app_font</item>
        <item name="android:imageButtonStyle">@style/PiperContainedImageButton</item>
        <item name="imageButtonStyle">@style/PiperContainedImageButton</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:fontFamily">@font/piper_app_font</item>
        <item name="fontFamily">@font/piper_app_font</item>
        <item name="android:imageButtonStyle">@style/PiperContainedImageButton</item>
        <item name="imageButtonStyle">@style/PiperContainedImageButton</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="TransparentBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
        <item name="android:fontFamily">@font/piper_app_font</item>
        <item name="fontFamily">@font/piper_app_font</item>
        <item name="android:imageButtonStyle">@style/PiperContainedImageButton</item>
        <item name="imageButtonStyle">@style/PiperContainedImageButton</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="MediaControlButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="MediaPrimaryControlButton" parent="MediaControlButton">
        <item name="android:background">@drawable/bg_media_icon</item>
        <item name="android:padding">10dp</item>
        <item name="tint">#07120B</item>
    </style>

    <style name="MediaFilterButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">#55FFFFFF</item>
        <item name="backgroundTint">#10171B</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">16dp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">51dp</item>
        <item name="android:background">#24FFFFFF</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="SettingsActionRow" parent="SettingsRow">
        <item name="android:layout_height">60dp</item>
    </style>

    <style name="SettingsRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="SettingsRowTextGroup">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="SettingsRowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#A6FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsActionTitle" parent="SettingsRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="autoSizeMinTextSize">10sp</item>
    </style>

    <style name="SettingsChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="thumbTint">#8DFFB0</item>
        <item name="trackTint">#54635A</item>
    </style>

    <style name="TerminalKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/bg_terminal_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#D8FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>
