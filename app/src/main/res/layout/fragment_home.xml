<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragmentHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="0dp"
        android:paddingEnd="18dp"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/home_tools_heading"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homePiperBrowser"
                android:layout_width="match_parent"
            android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:contentDescription="@string/piperos_browser"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"
                        android:contentDescription="@null" android:src="@drawable/browser" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/piperos_browser" android:textColor="@color/white"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
                            android:text="@string/piperos_browser_summary" android:textColor="#AFFFFFFF" android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:contentDescription="@null" android:rotation="180"
                        android:src="@drawable/ic_browser_back" app:tint="#BFFFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeFakeMap"
                android:layout_width="match_parent"
            android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:contentDescription="@string/piperos_fake_map"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"
                        android:contentDescription="@null" android:src="@drawable/ic_location_pin" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/piperos_fake_map" android:textColor="@color/white"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
                            android:text="@string/piperos_fake_map_summary" android:textColor="#AFFFFFFF" android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:contentDescription="@null" android:rotation="180"
                        android:src="@drawable/ic_browser_back" app:tint="#BFFFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homePiperQr"
                android:layout_width="match_parent"
            android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:contentDescription="@string/piperos_qr"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"
                        android:contentDescription="@null" android:src="@drawable/ic_piperos_qr" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/piperos_qr" android:textColor="@color/white"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
                            android:text="@string/piperos_qr_summary" android:textColor="#AFFFFFFF" android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:contentDescription="@null" android:rotation="180"
                        android:src="@drawable/ic_browser_back" app:tint="#BFFFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homePiperMedia"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:contentDescription="@string/piperos_media"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/nhacvideo" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/piperos_media"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/piperos_media_summary"
                            android:textColor="#AFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_browser_back"
                        app:tint="#BFFFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homePiper2fa"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:contentDescription="@string/piperos_2fa"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_2fa" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/piperos_2fa"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/piperos_2fa_summary"
                            android:textColor="#AFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_browser_back"
                        app:tint="#BFFFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
