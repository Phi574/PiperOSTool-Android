<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fileManagerRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090D10" android:orientation="vertical">
    <LinearLayout android:id="@+id/fileManagerToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="66dp" android:orientation="horizontal" android:paddingHorizontal="12dp" android:paddingVertical="9dp">
        <ImageButton android:id="@+id/btnFileManagerBack" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_browser_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/piperos_file_manager" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/fileManagerPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="start" android:maxLines="1" android:textColor="#8FFFFFFF" android:textSize="10sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnFileManagerHome" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Bộ nhớ trong" android:padding="10dp" android:src="@drawable/home" />
        <ImageButton android:id="@+id/btnFileManagerRefresh" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Làm mới" android:padding="10dp" android:src="@drawable/reload" />
        <ImageButton android:id="@+id/btnFileManagerMore" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Công cụ" android:padding="10dp" android:src="@drawable/ic_browser_more" />
    </LinearLayout>
    <EditText android:id="@+id/fileManagerSearch" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="14dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_glass_input" android:hint="Tìm trong thư mục hiện tại..." android:paddingHorizontal="15dp" android:singleLine="true" android:textColor="@color/white" android:textColorHint="#7FFFFFFF" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/fileManagerFiles" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp" />
        <TextView android:id="@+id/fileManagerEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Không có tệp phù hợp" android:textColor="#7FFFFFFF" android:textSize="13sp" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
