<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileManagerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/piper_window_background"
    android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fileManagerToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:contentPadding="0dp"
        app:cardPreventCornerOverlap="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            >
            <ImageButton
                android:id="@+id/btnFileManagerBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:src="@drawable/ic_browser_back"
                android:scaleType="centerInside" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/piperos_file_manager"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/fileManagerPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:maxLines="1"
                    android:textColor="#8FFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnFileManagerHome"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bộ nhớ trong"
                android:padding="10dp"
                android:src="@drawable/home"
                android:scaleType="centerInside" />
            <ImageButton
                android:id="@+id/btnFileManagerRefresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Làm mới"
                android:padding="10dp"
                android:src="@drawable/reload"
                android:scaleType="centerInside" />
            <ImageButton
                android:id="@+id/btnFileManagerMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Công cụ"
                android:padding="10dp"
                android:src="@drawable/ic_browser_more"
                android:scaleType="centerInside" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/fileManagerSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_modern_input"
            android:hint="Tìm trong thư mục hiện tại..."
            android:paddingStart="49dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#7FFFFFFF" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="15dp"
            android:src="@drawable/ic_browser_search"
            android:scaleType="fitCenter" />

    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fileSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:contentPadding="0dp"
        app:cardPreventCornerOverlap="false">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                >
                <TextView
                    android:id="@+id/fileSelectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 đã chọn"
                    android:textStyle="bold"
                    android:minWidth="64dp" />
                <ImageButton
                    android:id="@+id/fileSelectAll"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Chọn tất cả"
                    android:padding="10dp"
                    android:src="@drawable/check_circle"
                    android:scaleType="centerInside" />
                <ImageButton
                    android:id="@+id/fileCopySelected"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sao chép mục đã chọn"
                    android:padding="10dp"
                    android:src="@drawable/ic_file_copy"
                    android:scaleType="centerInside" />
                <ImageButton
                    android:id="@+id/fileMoveSelected"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Di chuyển mục đã chọn"
                    android:padding="10dp"
                    android:src="@drawable/ic_file_move"
                    android:scaleType="centerInside" />
                <ImageButton
                    android:id="@+id/fileCompressSelected"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Nén mục đã chọn"
                    android:padding="10dp"
                    android:src="@drawable/ic_file_archive"
                    android:scaleType="centerInside" />
                <ImageButton
                    android:id="@+id/fileBackupSelected"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sao lưu mục đã chọn"
                    android:padding="10dp"
                    android:src="@drawable/ic_file_backup"
                    android:scaleType="centerInside" />
                <ImageButton
                    android:id="@+id/fileDeleteSelected"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Xóa mục đã chọn"
                    android:padding="10dp"
                    android:src="@drawable/ic_file_delete"
                    android:scaleType="centerInside" />
                <ImageButton
                    android:id="@+id/fileSelectionClose"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Hủy chọn"
                    android:padding="10dp"
                    android:src="@drawable/ic_browser_close"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fileManagerFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />
        <TextView
            android:id="@+id/fileManagerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Không có tệp phù hợp"
            android:textColor="#7FFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fileManagerLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:contentPadding="0dp"
            app:cardPreventCornerOverlap="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                >
                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true" />
                <TextView
                    android:id="@+id/fileManagerLoadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:maxWidth="260dp"
                    android:maxLines="2"
                    android:text="Đang đọc thư mục..."
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
