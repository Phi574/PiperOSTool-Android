<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remote_stream_settings"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/remote_stream_settings_summary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/remoteStreamRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <RadioButton
            android:id="@+id/radioRemoteJpeg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remote_stream_jpeg" />

        <RadioButton
            android:id="@+id/radioRemoteH264"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remote_stream_h264" />

        <RadioButton
            android:id="@+id/radioRemoteHevc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/remote_stream_hevc" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyRemoteStream"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/apply" />
</LinearLayout>
