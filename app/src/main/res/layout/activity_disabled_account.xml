<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/disabledAccountRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/remote_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/account_disabled_title"
            android:src="@drawable/a3tn" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/account_disabled_title"
            android:textColor="@color/remote_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/account_disabled_message"
            android:textColor="@color/remote_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_account_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_disabled_email" android:textColor="@color/remote_text_primary" android:textStyle="bold" />
            <TextView android:id="@+id/disabledEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/remote_text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/account_disabled_time" android:textColor="@color/remote_text_primary" android:textStyle="bold" />
            <TextView android:id="@+id/disabledTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/remote_text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/account_disabled_reason" android:textColor="@color/remote_text_primary" android:textStyle="bold" />
            <TextView android:id="@+id/disabledReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/remote_text_secondary" />
        </LinearLayout>

        <EditText
            android:id="@+id/appealReason"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_account_field"
            android:gravity="top|start"
            android:hint="@string/account_appeal_hint"
            android:textColor="@color/remote_text_primary"
            android:textColorHint="@color/remote_text_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/account_appeal_eta"
            android:textColor="@color/remote_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSendAppeal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/account_send_appeal" />

        <Button
            android:id="@+id/btnRecheckAccount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/account_recheck" />

        <Button
            android:id="@+id/btnDisabledSignOut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/account_sign_out" />
    </LinearLayout>
</ScrollView>
