<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/remote_page_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnProfileBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_browser_back"
                app:tint="@color/remote_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title"
                    android:textColor="@color/remote_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_subtitle"
                    android:textColor="@color/remote_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_account_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvProfileStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/remote_accent"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etProfileUid"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_account_field"
                android:enabled="false"
                android:hint="@string/profile_uid"
                android:textColor="@color/remote_text_primary"
                android:textColorHint="@color/remote_text_secondary"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_account_field"
                android:hint="@string/profile_full_name"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/remote_text_primary"
                android:textColorHint="@color/remote_text_secondary" />

            <EditText
                android:id="@+id/etProfileBirthDate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_account_field"
                android:focusable="false"
                android:hint="@string/profile_birth_date"
                android:inputType="date"
                android:textColor="@color/remote_text_primary"
                android:textColorHint="@color/remote_text_secondary" />

            <Spinner
                android:id="@+id/spinnerProfileGender"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_account_field" />

            <EditText
                android:id="@+id/etProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_account_field"
                android:hint="@string/profile_phone"
                android:inputType="phone"
                android:maxLines="1"
                android:textColor="@color/remote_text_primary"
                android:textColorHint="@color/remote_text_secondary" />

            <EditText
                android:id="@+id/etProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_account_field"
                android:hint="@string/profile_email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="@color/remote_text_primary"
                android:textColorHint="@color/remote_text_secondary" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/profile_save_once" />

            <Button
                android:id="@+id/btnRequestProfileChange"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_change_request" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="@string/profile_review_eta"
            android:textColor="@color/remote_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
