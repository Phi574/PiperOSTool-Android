<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filePreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D10"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/filePreviewToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/btnFilePreviewBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:src="@drawable/ic_browser_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/filePreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filePreviewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8FFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFilePreviewEdit"
            style="@style/ApkEditorAction"
            android:layout_width="64dp"
            android:layout_marginEnd="4dp"
            android:text="SỬA"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnFilePreviewExternal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mở bằng ứng dụng khác"
            android:padding="10dp"
            android:src="@drawable/right" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/filePreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#050708"
            android:contentDescription="Xem trước ảnh"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/filePreviewPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#050708"
            android:visibility="gone"
            app:resize_mode="fit"
            app:show_buffering="when_playing" />

        <ImageView
            android:id="@+id/filePreviewAudioArt"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:contentDescription="Âm thanh"
            android:src="@drawable/ic_media_library"
            android:visibility="gone"
            app:tint="#7DFFB0" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <TextView
                android:id="@+id/filePreviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="18dp"
                android:textColor="#E8FFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/filePreviewPdfPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/filePreviewPdfImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Trang PDF"
                android:scaleType="fitCenter" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView android:id="@+id/btnPdfPrevious" style="@style/ApkEditorAction" android:text="TRƯỚC" />
                <TextView android:id="@+id/filePreviewPdfCounter" android:layout_width="120dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/white" android:textSize="12sp" />
                <TextView android:id="@+id/btnPdfNext" style="@style/ApkEditorAction" android:text="SAU" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/filePreviewUnsupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="28dp"
            android:textColor="#AFFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
