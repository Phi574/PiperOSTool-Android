<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/twoFactorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remote_page_background">

    <LinearLayout
        android:id="@+id/twoFactorContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/twoFactorToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/twoFactorBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/back"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="‹"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/twoFactorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="PiperOS 2FA"
                android:textColor="@color/remote_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/twoFactorSearchButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tìm kiếm tài khoản 2FA"
                android:padding="10dp"
                android:src="@drawable/ic_browser_search"
                app:tint="@color/remote_text_secondary" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/twoFactorScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:id="@+id/twoFactorScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="104dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/twoFactorIntroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/remote_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/remote_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_auth_input"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/icon_2fa" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mã xác minh, luôn sẵn sàng"
                                android:textColor="@color/remote_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Quản lý mã OTP cho các dịch vụ và đồng bộ an toàn theo tài khoản PiperOS."
                                android:textColor="@color/remote_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/twoFactorActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/twoFactorImport"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Nhập tài khoản"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/twoFactorExport"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Xuất / chuyển"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/twoFactorSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:hint="Tìm theo tên dịch vụ hoặc tài khoản"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/twoFactorStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/twoFactorStatusDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="8dp"
                        android:text="●"
                        android:textColor="@color/remote_accent"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/twoFactorStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đang tải tài khoản 2FA…"
                        android:textColor="@color/remote_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/twoFactorList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/twoFactorAdd"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Thêm tài khoản 2FA"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="+"
        android:textSize="28sp"
        app:cornerRadius="29dp" />
</FrameLayout>
