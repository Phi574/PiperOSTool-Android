<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingHorizontal="16dp">
    <ImageView android:id="@+id/securityActionIcon" android:layout_width="24dp" android:layout_height="24dp"
        android:contentDescription="@null" app:tint="@color/remote_text_secondary" android:src="@drawable/security" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/securityActionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/remote_text_primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/securityActionSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/remote_text_secondary" android:textSize="11sp" />
    </LinearLayout>
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:rotation="180"
        android:src="@drawable/ic_browser_back" app:tint="@color/remote_text_secondary" />
</LinearLayout>
