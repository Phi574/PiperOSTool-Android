<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/homeBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroud"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_screen_title"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeScreenSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/home_screen_summary"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHomeWindow"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_home_window_button"
            android:contentDescription="@string/home_window_title"
            android:padding="14dp"
            android:src="@drawable/window"
            app:tint="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/homeHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_home_navigation"
        android:clipToOutline="true"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/layoutBottomNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="5">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    app:tint="@color/green_neon"/>

                <TextView
                    android:id="@+id/txtHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/nav_home"
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/green_neon"
                    android:layout_marginTop="4dp"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navBeta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconNews"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_beta"
                    app:tint="@color/nav_unselected"/>

                <TextView
                    android:id="@+id/txtNews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/nav_beta"
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/nav_unselected"
                    android:layout_marginTop="4dp"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/iconApps"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/apps"
                    app:tint="@color/nav_unselected"/>
                <TextView
                    android:id="@+id/txtApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/nav_apps"
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/nav_unselected"
                    android:layout_marginTop="4dp"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconSettings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/settings"
                    app:tint="@color/nav_unselected"/>

                <TextView
                    android:id="@+id/txtSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/nav_settings"
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/nav_unselected"
                    android:layout_marginTop="4dp"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navDevices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconDevices"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/devices"
                    app:tint="@color/nav_unselected"/>

                <TextView
                    android:id="@+id/txtDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:text="@string/nav_info"
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="@color/nav_unselected"
                    android:layout_marginTop="4dp"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/homeWindowOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    <View
        android:id="@+id/homeWindowScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homeWindowPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:layout_marginVertical="12dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_window_title"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseHomeWindow"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close_browser"
                    android:padding="13dp"
                    android:src="@drawable/cancel_circle"
                    app:tint="@color/white" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_nav_border" />
            <LinearLayout
                android:id="@+id/homeWindowProfile"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp">
                <ImageView
                    android:id="@+id/iconHomeWindowProfile"
                    style="@style/SettingsRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/user" />
                <LinearLayout style="@style/SettingsRowTextGroup">
                    <TextView
                        android:id="@+id/titleHomeWindowProfile"
                        style="@style/SettingsRowTitle"
                        android:text="@string/home_personal_info" />
                    <TextView
                        android:id="@+id/summaryHomeWindowProfile"
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/home_personal_info_summary" />
                </LinearLayout>
                <ImageView style="@style/SettingsChevron" />
            </LinearLayout>

            <View
                android:id="@+id/dividerHomeProfileSecurity"
                style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/homeWindowSecurity"
                style="@style/SettingsRow">
                <ImageView
                    android:id="@+id/iconHomeWindowSecurity"
                    style="@style/SettingsRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/security" />
                <LinearLayout style="@style/SettingsRowTextGroup">
                    <TextView
                        android:id="@+id/titleHomeWindowSecurity"
                        style="@style/SettingsRowTitle"
                        android:text="@string/home_security" />
                    <TextView
                        android:id="@+id/summaryHomeWindowSecurity"
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/home_security_summary" />
                </LinearLayout>
                <ImageView style="@style/SettingsChevron" />
            </LinearLayout>

            <View
                android:id="@+id/dividerHomeSecuritySupport"
                style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/homeWindowRemoteStatus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/homeWindowLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="@color/white" />

                <TextView
                    android:id="@+id/homeWindowStatusIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="!"
                    android:textColor="#FF5252"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/homeWindowStatusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeWindowSupport"
                style="@style/SettingsRow">
                <ImageView
                    android:id="@+id/iconHomeWindowSupport"
                    style="@style/SettingsRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/error_bug" />
                <LinearLayout style="@style/SettingsRowTextGroup">
                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/home_support" />
                    <TextView
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/home_support_summary" />
                </LinearLayout>
                <ImageView style="@style/SettingsChevron" />
            </LinearLayout>

            <View
                android:id="@+id/homeWindowSupportSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/homeWindowWhatsNew"
                style="@style/SettingsRow">
                <ImageView
                    android:id="@+id/iconHomeWindowWhatsNew"
                    style="@style/SettingsRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/speaker" />
                <LinearLayout style="@style/SettingsRowTextGroup">
                    <TextView
                        android:id="@+id/titleHomeWindowWhatsNew"
                        style="@style/SettingsRowTitle"
                        android:text="@string/home_whats_new" />
                    <TextView
                        android:id="@+id/summaryHomeWindowWhatsNew"
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/home_whats_new_summary" />
                </LinearLayout>
                <ImageView style="@style/SettingsChevron" />
            </LinearLayout>

            <View
                android:id="@+id/dividerHomeWhatsNewLogout"
                style="@style/SettingsDivider" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeWindowLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/auth_logout"
                app:icon="@drawable/exit"
                app:iconSize="18dp"
                app:iconPadding="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
