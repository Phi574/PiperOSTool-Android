<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/textEditorRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090D10" android:orientation="vertical">
    <LinearLayout android:id="@+id/textEditorToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
        <ImageButton android:id="@+id/btnTextEditorBack" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_browser_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/textEditorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/textEditorPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8FFFFFFF" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/btnTextEditorSave" android:layout_width="72dp" android:layout_height="40dp" android:background="@drawable/bg_terminal_send" android:gravity="center" android:text="LƯU" android:textColor="#07120B" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <EditText android:id="@+id/textEditorContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_margin="12dp" android:layout_weight="1" android:background="@drawable/bg_terminal_screen" android:fontFamily="monospace" android:gravity="start|top" android:inputType="textMultiLine|textNoSuggestions" android:padding="16dp" android:scrollbars="vertical|horizontal" android:textColor="#E8FFF0" android:textSize="13sp" />
</LinearLayout>
