<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/advancedAccessRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/advancedAccessToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton android:id="@+id/advancedAccessBack" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:padding="10dp" android:src="@drawable/ic_browser_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pps_advanced_access" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/pps_advanced_access_summary" android:textSize="13sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/advancedAccessRefresh" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/pps_restart" android:padding="10dp" android:src="@drawable/reload" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/advancedAccessToolbar">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SettingsSectionTitle" android:text="@string/pps_service_section" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_surface" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:id="@+id/ppsMethodRow" android:layout_width="match_parent" android:layout_height="64dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" android:src="@drawable/ic_terminal" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pps_access_method" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/ppsMethodValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="30sp" />
                </LinearLayout>
                <TextView android:id="@+id/ppsState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textStyle="bold" />
                <TextView android:id="@+id/ppsIdentity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
                <TextView android:id="@+id/ppsCapabilities" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
                <TextView android:id="@+id/ppsError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFD85C61" android:textSize="12sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="end" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/ppsStop" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/pps_stop" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/ppsStart" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/pps_start" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsSectionTitle" android:layout_marginTop="20dp" android:text="@string/pps_file_access_section" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_surface" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="10dp">
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/ppsAndroidRestricted" style="@style/SettingsSwitch" android:layout_width="match_parent" android:clickable="true" android:focusable="true" android:text="@string/pps_android_restricted" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/ppsSystemFiles" style="@style/SettingsSwitch" android:layout_width="match_parent" android:clickable="true" android:focusable="true" android:text="@string/pps_system_files" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/ppsSystemWrite" style="@style/SettingsSwitch" android:layout_width="match_parent" android:clickable="true" android:focusable="true" android:text="@string/pps_system_write" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/ppsWorkspace" style="@style/SettingsSwitch" android:layout_width="match_parent" android:clickable="true" android:focusable="true" android:text="@string/pps_workspace" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/ppsHiddenFiles" style="@style/SettingsSwitch" android:layout_width="match_parent" android:clickable="true" android:focusable="true" android:text="@string/pps_hidden_files" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/ppsExportDiagnostics" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:text="@string/pps_export_diagnostics" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/pps_security_note" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
