<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="20dp"
    android:paddingTop="52dp"
    android:paddingEnd="20dp"
    android:paddingBottom="118dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/beta_lab_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/beta_lab_subtitle"
            android:textColor="#B8FFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featurePiperMedia"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#E612171C"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#5AFFFFFF"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/mediaFeatureIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_media_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/nhacvideo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/mediaFeatureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/piperos_media"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/mediaFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/mediaFeatureIcon"
                    app:layout_constraintTop_toTopOf="@id/mediaFeatureIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/piperos_media_summary"
                    android:textColor="#AFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/mediaFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/mediaFeatureIcon"
                    app:layout_constraintTop_toBottomOf="@id/mediaFeatureTitle" />

                <TextView android:id="@+id/mediaFeatureStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_feature_beta_pill" android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:text="@string/beta_status" android:textColor="#147C60" android:textSize="10sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featurePiperTerminal"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#E612171C"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#5AFFFFFF"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/terminalFeatureIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_terminal_send"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_terminal"
                        app:tint="#08110B" />
                </FrameLayout>

                <TextView
                    android:id="@+id/terminalFeatureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/piperos_terminal"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="13sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toStartOf="@id/terminalFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/terminalFeatureIcon"
                    app:layout_constraintTop_toTopOf="@id/terminalFeatureIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/piperos_terminal_summary"
                    android:textColor="#AFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/terminalFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/terminalFeatureIcon"
                    app:layout_constraintTop_toBottomOf="@id/terminalFeatureTitle" />

                <TextView android:id="@+id/terminalFeatureStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_feature_beta_pill" android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:text="@string/beta_status" android:textColor="#147C60" android:textSize="10sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featureFileManager"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#E612171C"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#5AFFFFFF"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/fileManagerFeatureIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_browser_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/module"
                        app:tint="#07120B" />
                </FrameLayout>

                <TextView
                    android:id="@+id/fileManagerFeatureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/piperos_file_manager"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toStartOf="@id/fileManagerFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/fileManagerFeatureIcon"
                    app:layout_constraintTop_toTopOf="@id/fileManagerFeatureIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/piperos_file_manager_summary"
                    android:textColor="#AFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/fileManagerFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/fileManagerFeatureIcon"
                    app:layout_constraintTop_toBottomOf="@id/fileManagerFeatureTitle" />

                <TextView android:id="@+id/fileManagerFeatureStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_feature_beta_pill" android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:text="@string/beta_status" android:textColor="#147C60" android:textSize="10sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featurePiperRemote"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#E612171C"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#5AFFFFFF"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/remoteFeatureIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_browser_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_remote_view"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/remoteFeatureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/piperos_remote"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toStartOf="@id/remoteFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/remoteFeatureIcon"
                    app:layout_constraintTop_toTopOf="@id/remoteFeatureIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/piperos_remote_summary"
                    android:textColor="#AFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/remoteFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/remoteFeatureIcon"
                    app:layout_constraintTop_toBottomOf="@id/remoteFeatureTitle" />

                <TextView android:id="@+id/remoteFeatureStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_feature_beta_pill" android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:text="@string/beta_status" android:textColor="#147C60" android:textSize="10sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featurePiperAdb"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/piperos_adb"
            app:cardBackgroundColor="#E612171C"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#5AFFFFFF"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/adbFeatureIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_browser_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_terminal" />
                </FrameLayout>

                <TextView
                    android:id="@+id/adbFeatureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/piperos_adb"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/adbFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/adbFeatureIcon"
                    app:layout_constraintTop_toTopOf="@id/adbFeatureIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/piperos_adb_summary"
                    android:textColor="#AFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/adbFeatureStatus"
                    app:layout_constraintStart_toEndOf="@id/adbFeatureIcon"
                    app:layout_constraintTop_toBottomOf="@id/adbFeatureTitle" />

                <TextView
                    android:id="@+id/adbFeatureStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_feature_beta_pill"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="@string/beta_status"
                    android:textColor="#147C60"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featurePiperQr"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/piperos_qr"
            app:cardBackgroundColor="#E612171C"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#5AFFFFFF"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <FrameLayout
                    android:id="@+id/qrFeatureIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_qr_feature_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/piperosQrIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_piperos_qr" />
                </FrameLayout>

                <TextView
                    android:id="@+id/qrFeatureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/piperos_qr"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/qrPreviewBadgeBeta"
                    app:layout_constraintStart_toEndOf="@id/qrFeatureIcon"
                    app:layout_constraintTop_toTopOf="@id/qrFeatureIcon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/piperos_qr_summary"
                    android:textColor="#AFFFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/qrPreviewBadgeBeta"
                    app:layout_constraintStart_toEndOf="@id/qrFeatureIcon"
                    app:layout_constraintTop_toBottomOf="@id/qrFeatureTitle" />

                <TextView
                    android:id="@+id/qrPreviewBadgeBeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_feature_beta_pill"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="@string/beta_status"
                    android:textColor="#147C60"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
