<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:centerColor="#2A3338"
                android:endColor="#050708"
                android:startColor="#161D21" />
            <stroke android:width="1dp" android:color="#5AFFFFFF" />
        </shape>
    </item>
    <item android:inset="25dp">
        <shape android:shape="oval">
            <solid android:color="#39E58C" />
        </shape>
    </item>
    <item android:inset="48dp">
        <shape android:shape="oval">
            <solid android:color="#08100C" />
        </shape>
    </item>
</layer-list>
