{
  "schemaVersion": 1,
  "screenId": "signup",
  "layout": {
    "type": "frame", "id": "signupRoot", "width": "match", "height": "match", "background": "@color/black",
    "children": [
      { "type": "image", "id": "authBackground", "width": "match", "height": "match", "src": "@drawable/backgroud", "scaleType": "centerCrop", "contentDescription": "" },
      { "type": "view", "id": "modernAuthOverlay", "width": "match", "height": "match", "background": "@drawable/bg_auth_overlay" },
      { "type": "scroll", "width": "match", "height": "match", "fillViewport": true,
        "children": [
          { "type": "linear", "width": "match", "height": "wrap", "orientation": "vertical", "gravity": "center_horizontal", "padding": [24, 26, 24, 28],
            "children": [
              { "type": "image", "width": 64, "height": 64, "src": "@drawable/a3tn", "contentDescription": "@string/app_name" },
              { "type": "text", "width": "wrap", "height": "wrap", "margin": [0, 10, 0, 0], "text": "@string/auth_create_title", "textColor": "@color/white", "textSize": 26, "bold": true },
              { "type": "text", "id": "signupVersion", "width": "wrap", "height": "wrap", "margin": [0, 4, 0, 0], "text": "@string/auth_version_placeholder", "textColor": "#AFFFFFFF", "textSize": 12 },
              { "type": "text", "id": "signupOfflineState", "width": "match", "height": "wrap", "margin": [0, 16, 0, 0], "background": "@drawable/bg_offline_notice", "paddingAll": 14, "text": "@string/auth_offline_note", "textColor": "#FFFFD180", "textSize": 13, "visibility": "gone" },
              { "type": "linear", "width": "match", "height": "wrap", "margin": [0, 18, 0, 0], "background": "@drawable/bg_auth_panel", "orientation": "vertical", "paddingAll": 20,
                "children": [
                  { "type": "text", "width": "wrap", "height": "wrap", "text": "@string/auth_identity_details", "textColor": "@color/white", "textSize": 18, "bold": true },
                  { "type": "edit", "id": "edtSignupName", "width": "match", "height": 52, "margin": [0, 18, 0, 0], "background": "@drawable/bg_auth_input", "padding": [14, 8], "hint": "@string/auth_name_hint", "inputType": "textPersonName", "textColor": "@color/white" },
                  { "type": "edit", "id": "edtSignupEmail", "width": "match", "height": 52, "margin": [0, 10, 0, 0], "background": "@drawable/bg_auth_input", "padding": [14, 8], "hint": "@string/auth_email_hint", "inputType": "textEmailAddress", "textColor": "@color/white" },
                  { "type": "edit", "id": "edtSignupPassword", "width": "match", "height": 52, "margin": [0, 10, 0, 0], "background": "@drawable/bg_auth_input", "padding": [14, 8], "hint": "@string/auth_new_password_hint", "inputType": "textPassword", "textColor": "@color/white" },
                  { "type": "edit", "id": "edtSignupConfirm", "width": "match", "height": 52, "margin": [0, 10, 0, 0], "background": "@drawable/bg_auth_input", "padding": [14, 8], "hint": "@string/auth_confirm_password_hint", "inputType": "textPassword", "textColor": "@color/white" },
                  { "type": "button", "id": "btnRegister", "width": "match", "height": 54, "margin": [0, 18, 0, 0], "background": "@drawable/bg_auth_primary", "text": "@string/auth_signup_action", "textColor": "#DFFFFFFF", "textSize": 14 }
                ]
              },
              { "type": "text", "width": "match", "height": "wrap", "margin": [0, 14, 0, 0], "gravity": "center", "text": "@string/auth_or_continue", "textColor": "#AFFFFFFF", "textSize": 12 },
              { "type": "linear", "width": "match", "height": 56, "margin": [0, 8, 0, 0], "orientation": "horizontal",
                "children": [
                  { "type": "imageButton", "id": "btnGoogleSignIn", "width": 0, "height": "match", "weight": 1, "background": "@drawable/bg_auth_panel", "paddingAll": 14, "src": "@drawable/auth_google", "contentDescription": "@string/auth_google_button_description" },
                  { "type": "imageButton", "id": "btnPhoneSignIn", "width": 0, "height": "match", "weight": 1, "margin": [10, 0, 0, 0], "background": "@drawable/bg_auth_panel", "paddingAll": 14, "src": "@drawable/auth_phone", "contentDescription": "@string/auth_phone_button_description" }
                ]
              },
              { "type": "text", "id": "tvBackToLogin", "width": "match", "height": 52, "margin": [0, 12, 0, 0], "background": "@drawable/bg_auth_panel", "gravity": "center", "text": "@string/auth_back_login", "textColor": "#DFFFFFFF" }
            ]
          }
        ]
      }
    ]
  }
}
