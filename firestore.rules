rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /browserVault/{documentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && documentId == 'config'
          && request.resource.data.keys().hasOnly([
            'version', 'kdf', 'iterations', 'salt', 'wrappedKey',
            'pinLength', 'updatedAt'
          ])
          && request.resource.data.version == 1
          && request.resource.data.kdf == 'PBKDF2-HMAC-SHA256'
          && request.resource.data.iterations >= 600000
          && request.resource.data.pinLength >= 4
          && request.resource.data.pinLength <= 64
          && request.resource.data.salt is string
          && request.resource.data.salt.size() <= 128
          && request.resource.data.wrappedKey is string
          && request.resource.data.wrappedKey.size() <= 512;
      }

      match /browserVaultEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'version', 'payload', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.version == 1
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 16384
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int;
      }

      match /accountProfile/{documentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && documentId == 'main'
          && !exists(/databases/$(database)/documents/users/$(uid)/accountProfile/main)
          && request.resource.data.keys().hasOnly([
            'uid', 'fullName', 'dateOfBirth', 'gender', 'phoneNumber',
            'email', 'locked', 'createdAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 2
          && request.resource.data.fullName.size() <= 120
          && request.resource.data.dateOfBirth is string
          && request.resource.data.dateOfBirth.size() == 10
          && request.resource.data.gender in ['male', 'female', 'other', 'prefer_not_to_say']
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.size() >= 7
          && request.resource.data.phoneNumber.size() <= 24
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.locked == true
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }

      match /profileChangeRequests/{requestId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'requestId', 'uid', 'email', 'reason', 'status', 'createdAt'
          ])
          && request.resource.data.requestId == requestId
          && request.resource.data.uid == uid
          && request.resource.data.email is string
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 10
          && request.resource.data.reason.size() <= 4000
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }

      match /deviceSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.sessionId == sessionId
          && request.resource.data.keys().hasOnly([
            'sessionId', 'deviceId', 'deviceName', 'manufacturer', 'model',
            'androidVersion', 'sdk', 'abis', 'platform', 'windowsVersion',
            'architecture', 'app', 'appVersion', 'updatedAt',
            'loginAt', 'lastSeenAt', 'active', 'revoked', 'status',
            'locationLat', 'locationLon'
          ])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceName is string
          && request.resource.data.loginAt is int
          && request.resource.data.lastSeenAt is int
          && request.resource.data.active == true
          && request.resource.data.revoked == false
          && request.resource.data.status == 'active';
        allow update: if isOwner(uid)
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.deviceId == resource.data.deviceId
          && (resource.data.revoked != true || request.resource.data.revoked == true)
          && request.resource.data.keys().hasOnly([
            'sessionId', 'deviceId', 'deviceName', 'manufacturer', 'model',
            'androidVersion', 'sdk', 'abis', 'platform', 'windowsVersion',
            'architecture', 'app', 'appVersion', 'updatedAt',
            'loginAt', 'lastSeenAt', 'active', 'revoked', 'status',
            'locationLat', 'locationLon', 'signedOutAt', 'revokedAt', 'revokedBy'
          ]);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
